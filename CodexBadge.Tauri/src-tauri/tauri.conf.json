{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Badge",
  "version": "0.3.1",
  "identifier": "app.codexbadge.tauri",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "capsule",
        "create": false,
        "title": "Codex Badge",
        "url": "index.html?view=capsule",
        "width": 30,
        "height": 30,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "focusable": false,
        "focus": false
      },
      {
        "label": "detail",
        "create": false,
        "title": "Codex Badge Detail",
        "url": "index.html?view=detail",
        "width": 270,
        "height": 148,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "focusable": false,
        "focus": false
      },
      {
        "label": "credit",
        "create": false,
        "title": "Codex Badge Reset Credits",
        "url": "index.html?view=credit",
        "width": 205,
        "height": 36,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "focusable": false,
        "focus": false
      },
      {
        "label": "menu",
        "create": false,
        "title": "Codex Badge Menu",
        "url": "index.html?view=menu",
        "width": 190,
        "height": 116,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "focusable": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
