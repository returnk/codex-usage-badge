<Window x:Class="CodexBadge.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="270" Height="148" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="False">
    <Window.Resources>
        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2.5" />
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                        CornerRadius="2.5" HorizontalAlignment="Left" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" CornerRadius="15" Padding="16,12" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow" BlurRadius="16" ShadowDepth="3" Opacity="0.18" />
        </Border.Effect>
        <StackPanel>
            <Grid Height="25">
                <TextBlock x:Name="FiveHourLabel" FontFamily="Segoe UI"
                           FontSize="13" VerticalAlignment="Center">
                    <Run Text="5 小时" /><Run x:Name="FiveHourUnavailableRun" />
                </TextBlock>
                <TextBlock x:Name="FiveHourPercentText" Text="--%" FontFamily="Segoe UI"
                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <ProgressBar x:Name="FiveHourProgress" Style="{StaticResource ThinProgress}" Margin="0,4,0,0" />
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FiveHourResetText" Grid.Column="0" FontFamily="Segoe UI"
                           FontSize="11.5" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusText" Grid.Column="1" FontFamily="Segoe UI" FontSize="10.5"
                           Margin="8,0,0,0"
                           HorizontalAlignment="Right" Opacity="0.65" />
            </Grid>

            <Border x:Name="Divider" Height="1" Margin="0,9,0,7" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WeeklyText" Grid.Column="0" Text="本周剩余"
                           FontFamily="Segoe UI" FontSize="12.5" VerticalAlignment="Center" />
                <TextBlock x:Name="WeeklyPercentText" Grid.Column="1" Text="--%" FontFamily="Segoe UI"
                           FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Margin="0,6,0,0">
                <TextBlock x:Name="WeeklyResetText" FontFamily="Segoe UI" FontSize="11.5" />
                <TextBlock x:Name="CreditText" FontFamily="Segoe UI" FontSize="11.5"
                           HorizontalAlignment="Right">
                    <Run x:Name="CreditCountRun" Text="--" /><Run x:Name="CreditSuffixRun" Text="次重置机会" />
                </TextBlock>
            </Grid>
        </StackPanel>
    </Border>
</Window>
