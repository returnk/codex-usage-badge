<Window x:Class="CodexBadge.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="190" Height="154" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FF36383D" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="13,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FFF1F5FB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FFE7EEF9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="7" Padding="5" Background="#FFFCFCFD" BorderBrush="#24000000"
            BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.22" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="42" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Button x:Name="StartupButton" Grid.Row="0" Style="{StaticResource MenuButton}">
                <Grid>
                    <TextBlock Text="开机启动" VerticalAlignment="Center" />
                    <TextBlock x:Name="StartupCheck" Text="✓" FontFamily="Segoe UI Symbol"
                               FontSize="19" FontWeight="SemiBold" Foreground="#FF377DFF"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button x:Name="RelocateButton" Grid.Row="1" Style="{StaticResource MenuButton}"
                    Content="重新定位" />
            <Button x:Name="ExitButton" Grid.Row="2" Style="{StaticResource MenuButton}"
                    Content="退出" />
        </Grid>
    </Border>
</Window>
